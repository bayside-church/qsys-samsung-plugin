  "Lua.diagnostics.disable": [
    "lowercase-global"
  ],
  "[lua]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "files.autoSave": "off",
  "editor.renderControlCharacters": true
}
