{
  "files.associations": {
    "*.qplug": "lua",
    "*.json": "jsonc"
  },
  "Lua.diagnostics.globals": [
    "PluginInfo",
    "Controls",
    "Properties",
    "Component",
    "Design",
    "System",
    "GetProperties",
    "RectifyProperties",
    "GetControls",
    "GetControlLayout",
    "GetPages",
    "GetComponents",
    "GetPins",
    "GetWiring",
    "GetColor",
    "GetPrettyName",
    "Timer",
    "TcpSocket",
    "TcpSocketServer",
    "UdpSocket",
    "WebSocket",
    "HttpClient",
    "Ssh",
    "SerialPorts",
    "SerialServerPorts",
    "Json",
    "JSON",
    "rapidjson",
    "Log",
    "Network",
    "Notifications",
    "Ping",
    "SNMP",
    "SNMPTrap",
    "Uci",
    "UCI",
    "EzSVG",
    "QRCode",
    "Mixer",
    "Snapshot",
    "NamedControl",
    "Email",
    "dir",
    "bit",
    "bitstring",
    "LuaXML",
    "date"
